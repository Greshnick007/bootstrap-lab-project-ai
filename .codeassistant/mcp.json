{
  "mcpServers": {
    "context7": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ],
      "env": {
        "DEFAULT_MINIMUM_TOKENS": ""
      }
    },
    "pixso": {
			"type": "streamable-http",
			"url": "http://127.0.0.1:3667/mcp",
			"disabled": false
		}
  }
}